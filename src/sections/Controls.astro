<section
  data-section='controls'
  class='flex flex-col items-center justify-center'
>
  <div class='flex flex-col items-center justify-center gap-6 space-x-2 sm:flex-row'>
    <!-- Lightness -->
    <div class='space-y-2'>
      <label
        for='lightnessSlider'
        class='block text-base font-medium tracking-wide text-neutral-600 uppercase'
      >
        Lightness <span
          id='lightnessValue'
          class='text-xs font-normal text-neutral-400'
        ></span>
      </label>
      <input
        type='range'
        id='lightnessSlider'
        min='0.5'
        max='1.5'
        step='0.05'
        value='1'
        class='h-2 w-full cursor-pointer appearance-none rounded-lg bg-neutral-200 accent-blue-500'
      />
      <div class='flex justify-between text-xs text-neutral-400'>
        <span>Darker</span>
        <span>Lighter</span>
      </div>
    </div>

    <!-- Chroma Override -->
    <div class='space-y-2'>
      <label
        for='chromaSlider'
        class='block text-base font-medium tracking-wide text-neutral-600 uppercase'
      >
        Chroma <span
          id='chromaValue'
          class='text-xs font-normal text-neutral-400'
        ></span>
      </label>
      <input
        type='range'
        id='chromaSlider'
        min='0'
        max='0.4'
        step='0.001'
        class='h-2 w-full cursor-pointer appearance-none rounded-lg bg-neutral-200 accent-blue-500'
      />
      <div class='flex justify-between text-xs text-neutral-400'>
        <span>0</span>
        <span>0.4</span>
      </div>
    </div>

    <!-- Hue Override -->
    <div class='space-y-2'>
      <label
        for='hueSlider'
        class='block text-base font-medium tracking-wide text-neutral-600 uppercase'
      >
        Hue <span
          id='hueValue'
          class='text-xs font-normal text-neutral-400'
        ></span>
      </label>
      <input
        type='range'
        id='hueSlider'
        min='0'
        max='360'
        step='1'
        class='h-2 w-full cursor-pointer appearance-none rounded-lg bg-neutral-200 accent-blue-500'
      />
      <div class='flex justify-between text-xs text-neutral-400'>
        <span>0</span>
        <span>360</span>
      </div>
    </div>
  </div>

  <!-- Action Button -->
  <button
    id='resetBtn'
    class='m-3 cursor-pointer rounded-lg border border-neutral-300 bg-white px-6 py-3 text-sm font-medium text-neutral-700 shadow-sm transition-all hover:bg-neutral-50 hover:shadow active:scale-95'
  >
    Reset
  </button>
</section>
